# =============================================================================
# Smart Timetable System — full-stack Next.js app environment variables
# -----------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in real values:
#     cp .env.example .env.local
#
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser. Everything
# else is server-only (used by the API route handlers under src/app/api) and
# is NEVER sent to the client.
# =============================================================================

# ---- Client (browser) -------------------------------------------------------
# Base URL for API calls. Leave blank to use the same origin (recommended now
# that the API lives in this app). Set it only if the API is hosted elsewhere.
NEXT_PUBLIC_API_URL=

# ---- Server: Database -------------------------------------------------------
# Full MongoDB connection string, e.g.
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/Smarttimetablesystem

# ---- Server: Auth -----------------------------------------------------------
# Secret used to sign JWTs. Use a long, random string.
JWT_SECRET=change-me-to-a-long-random-string

# ---- Server: Arkesel SMS ----------------------------------------------------
# Used to notify students/lecturers on timetable generation, subscription, and
# class change/cancellation alerts. Sender ID must be pre-approved by Arkesel
# and is max 11 characters.
ARKESEL_API_KEY=your-arkesel-api-key
ARKESEL_SENDER=GCTU
